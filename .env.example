# Wajib (akun: api.gencipta.com)
GENCIPTA_API_KEY=isi_api_key_gencipta
GENCIPTA_BASE_URL=https://gateway.gencipta.com
GENCIPTA_PATH_AM_SEND=/api/am-generator/send-link
GENCIPTA_PATH_AM_VERIF=/api/am-generator/verify-link
GENCIPTA_PATH_SPOTIFY_SEARCH=/api/spotify/search
GENCIPTA_PATH_TIKTOK=/api/downloader/tiktok
GENCIPTA_PATH_YOUTUBE=/api/downloader/youtube
GENCIPTA_PATH_BRAT=/api/v2/maker/brat
GENCIPTA_PATH_BRATVID=/api/maker/bratvid
GENCIPTA_PATH_FAKECH=/api/maker/fake-ch-ios
GENCIPTA_PATH_FAKECALL=/api/maker/fake-call-ios
GENCIPTA_PATH_JARVIS=/api/maker/jarvis-meme
GENCIPTA_PATH_IGQC=/api/maker/igqc
GENCIPTA_PATH_IMG2PROMPT=/api/tools/image-to-prompt
GENCIPTA_PATH_BYPASSCF=/api/tools/bypass-cf
GENCIPTA_PATH_UPSCALE=/api/v2/tools/upscale
GENCIPTA_PATH_AMDATA=/api/tools/amdata
GENCIPTA_PATH_REMOVEBG=/api/tools/removebg
GENCIPTA_PATH_TOQR=/api/tools/toqr
GENCIPTA_PATH_SSWEB=/api/tools/ssweb
GENCIPTA_PATH_TTSGOOGLE=/api/tools/tts-google
GENCIPTA_PATH_OPENGRAPH=/api/tools/web/open-graph

# Opsional: kunci halaman dengan kode akses
ACCESS_CODE=

# Diisi otomatis saat Blob store di-connect ke project (hanya untuk foto)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (Vercel: Storage / Marketplace -> Upstash Redis -> Connect). Salah satu pasangan ini terisi otomatis.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Rahasia cron pembersih foto sementara (acak, minimal 16 karakter)
CRON_SECRET=

# Login Google (lihat README)
GOOGLE_CLIENT_ID=
# Acak, minimal 32 karakter. Buat dengan: openssl rand -hex 32
SESSION_SECRET=
# Login wajib untuk semua orang (bawaan: aktif). Isi 0 HANYA bila ingin halaman terbuka untuk tamu.
REQUIRE_LOGIN=

# SMTP: kirim kode verifikasi pendaftaran dan reset kata sandi (wajib untuk daftar username/password)
SMTP_HOST=
SMTP_PORT=465
# 1 = SSL langsung (port 465), 0 = STARTTLS (port 587). Kosong = otomatis dari port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Opsional, contoh: "Malik Tools" <noreply@domainmu.com>
SMTP_FROM=
APP_NAME=Malik Tools
# Developer: email Google yang boleh membuka panel Developer (pisahkan dengan koma)
# OWNER_EMAILS lama tetap dibaca, jadi tidak perlu diganti kalau sudah terisi.
DEVELOPER_EMAILS=
# Opsional: batasi hanya email tertentu, pisahkan dengan koma
ALLOWED_EMAILS=

# Jatah limit AM Premium per 24 jam (opsional, bawaan 5 / 15 / 30)
CREDIT_MEMBER=5
CREDIT_PREMIUM=15
CREDIT_VIP=30

# Bot WhatsApp pengumuman tool baru (lihat folder malik-bot)
# Tamako MD: BOT_WEBHOOK_URL = alamat publik API internal bot (contoh https://bot.cloudstore.my.id), BOT_SECRET = sama dengan BOT_INTERNAL_API_KEY di .env bot
BOT_WEBHOOK_URL=
BOT_SECRET=
# Opsional: path endpoint pengumuman di bot (bawaan /api/channel/new-tool)
BOT_WEBHOOK_PATH=/api/channel/new-tool
CHAT_BAD_WORDS=
GENCIPTA_PATH_CARBON=/api/v2/maker/carbon
GENCIPTA_PATH_INSTAGRAM=/api/downloader/instagram-v2
GENCIPTA_PATH_MEDIAFIRE=/api/downloader/mediafire
GENCIPTA_PATH_GC_START=/api/getcontact/verification/start

# Opsional: tool Reaksi Channel WhatsApp (NexaDev). Isi di Vercel, jangan ditulis di kode.
NEXADEV_API_KEY=isi_api_key_nexadev
NEXADEV_BASE_URL=https://api.nexadev.my.id

# AM Premium: jalur cadangan dua arah GenCipta <-> NexaDev (butuh GENCIPTA_API_KEY dan NEXADEV_API_KEY di atas).
# Bila salah satu error, otomatis pindah ke yang lain dan jalur yang terakhir berhasil dipakai lebih dulu.
# Opsional: kunci urutan pertama. Isi gencipta atau nexadev; kosong = otomatis (auto).
AM_PROVIDER=
# Opsional: ubah path NexaDev bila berbeda dari dokumentasi (bawaan /am/send/ dan /am/verif/)
# NEXADEV_PATH_AM_SEND=/am/send/
# NEXADEV_PATH_AM_VERIF=/am/verif/

# api-cloud.my.id (paket Pro): tool IQC Dark. Key OPSIONAL: kosongkan bila docs memanggil tanpa key.
CLOUDAPI_API_KEY=
CLOUDAPI_BASE_URL=https://api-cloud.my.id
# Nama parameter query untuk kunci (lihat halaman Docs api-cloud). Bawaan: apikey. Kunci juga dikirim lewat header x-api-key.
CLOUDAPI_KEY_PARAM=apikey
# Origin/Referer yang dikirim backend ke api-cloud (untuk whitelist domain apikey). Isi "-" untuk mematikan.
CLOUDAPI_ORIGIN=https://maliktools.biz.id
# Path tool api-cloud (opsional, hanya bila berbeda dari bawaan): IQC Dark /canvas/iqcdark, Duar Viral /maker/duarviral
# CLOUDAPI_PATH_IQCDARK=/canvas/iqcdark
# CLOUDAPI_PATH_DUARVIRAL=/maker/duarviral
# CLOUDAPI_PATH_AMFIND=/tools/amfind

# Opsional: pemberitahuan error server (URL webhook Discord / Slack). Kosong = hanya dicatat di panel developer.
ERROR_WEBHOOK_URL=
# Opsional: origin tambahan yang boleh mengirim POST ke API (dipisah koma), mis. https://admin.contoh.com
ALLOWED_ORIGINS=
# api-cloud SW HD (plan Pro & Enterprise): GET /tools/swhd?url=&json=
CLOUDAPI_PATH_SWHD=/tools/swhd
# api-cloud AM Prem V2 (Amprem V5, plan Pro & Enterprise): GET /premium/amprem5?action=&email=&link=
CLOUDAPI_PATH_AMPREM5=/premium/amprem5
# Nilai parameter action: 1 = Kirim link, 2 = Verifikasi (sesuai docs api-cloud).
CLOUDAPI_AMPREM5_ACTION_SEND=1
CLOUDAPI_AMPREM5_ACTION_VERIF=2

# Beli role otomatis lewat Meldapay (QRIS). Ambil dari meldapay.com, menu Profil. Kosong = Beli Role tetap lewat chat WhatsApp developer.
MELDAPAY_APIKEY=
# Webhook Secret dari menu Profil Meldapay (untuk memverifikasi header X-Signature). Opsional tetapi disarankan.
MELDAPAY_WEBHOOK_SECRET=
# Opsional, bawaan https://meldapay.com
# MELDAPAY_BASE_URL=https://meldapay.com
